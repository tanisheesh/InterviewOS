# Clerk — get from https://clerk.com/dashboard (your app > API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Supabase — get from https://supabase.com/dashboard/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Service role key — server-side only, never expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Groq — get from https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# App URL (set to your Vercel URL in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
